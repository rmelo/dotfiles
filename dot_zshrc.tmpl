
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.dotnet/tools:$PATH"

#OH-MY-ZSH
export ZSH="$HOME/.oh-my-zsh"

#THEMES
#ZSH_THEME="robbyrussell"
#ZSH_THEME="bira"
ZSH_THEME="afowler"
#ZSH_THEME="amuse"
#ZSH_THEME="minimal"
#ZSH_THEME="nanotech"

plugins=(git) 
source $ZSH/oh-my-zsh.sh

# Prefer 1Password SSH Agent if available
{{ if eq .chezmoi.os "darwin" -}}
ONEPASS_AGENT="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else if eq .chezmoi.os "linux" -}}
ONEPASS_AGENT="$HOME/.1password/agent.sock"
{{- end }}
if [ -S "$ONEPASS_AGENT" ]; then
  export SSH_AUTH_SOCK="$ONEPASS_AGENT"
fi

{{ if eq .chezmoi.os "darwin" }}
# ========== Keyboard bindings ==========

# Option + Delete → delete previous word
bindkey '^[^?' backward-kill-word

# Option + ← → move backward by word
bindkey '^[b' backward-word

# Option + → → move forward by word
bindkey '^[f' forward-word

# Optional: Option + fn + Delete → delete next word (some keyboards)
bindkey '^[^[[3~' kill-word
{{ end}}

{{ if eq .chezmoi.os "linux" }}
# 1. Fix Alt + Backspace (Line Deletion/Kill)
# Your keyd sends alt+backspace as a single signal; Zsh needs to map it to backward-kill-line
bindkey '^[[127;3u' backward-kill-line   # Standard Alt+Backspace code
bindkey '^U' backward-kill-line          # Backup for C-u (which keyd is likely sending)

# 2. Fix Alt + Left (Select to Home)
# Note: Zsh doesn't have a "Select" mode by default like a text editor.
# We map it to move to the beginning of the line:
bindkey '^[[1;3D' beginning-of-line      # Common code for Alt+Left
bindkey '^[[H' beginning-of-line         # Home key code

# 3. Fix Alt + Right (Select to End)
bindkey '^[[1;3C' end-of-line            # Common code for Alt+Right
bindkey '^[[F' end-of-line               # End key code
{{ end}}

# Usefull functions
reload (){ source ~/.zshrc }
go-workspace (){ cd ~/Workspace/ }
go-me (){ cd ~/Workspace/me/ }
go-work (){ cd ~/Workspace/work/ }
go-travelier (){ cd ~/Workspace/work/travelier/ }
go-brands (){ cd ~/Workspace/work/travelier/brands }
go-do (){ cd ~/Workspace/work/travelier/brands/do/ }
go-bo (){ cd ~/Workspace/work/travelier/brands/bo/ }
go-p10 (){ cd ~/Workspace/work/travelier/brands/p10/ }

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/rodrigomelo/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/rodrigomelo/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/rodrigomelo/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/rodrigomelo/google-cloud-sdk/completion.zsh.inc'; fi

# Kiro AWS

[[ "$TERM_PROGRAM" == "kiro" ]] && . "$(kiro --locate-shell-integration-path zsh)"


# Anthropic Claude

alias claude-work='CLAUDE_CONFIG_DIR=~/.claude-work/ /Users/rodrigomelo/.local/bin/claude "/color red"'
alias claude-me='CLAUDE_CONFIG_DIR=~/.claude-me/ /Users/rodrigomelo/.local/bin/claude "/color yellow" '
alias claude="echo 'Use specific commands: claude-me or claude-work'"
